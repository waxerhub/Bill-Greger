# ── Server-side (never prefix with VITE_ — keeps key out of the browser) ──────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional: port for the Express server (default: 3000) ────────────────────
# PORT=3000

# ── Supabase (cloud character storage) ───────────────────────────────────────
# Create a free project at supabase.com, then run this SQL in the SQL editor:
#
#   create table characters (
#     id uuid default gen_random_uuid() primary key,
#     name text not null default 'Unnamed',
#     data jsonb not null,
#     updated_at timestamptz default now()
#   );
#   create index on characters (updated_at desc);
#
# Then paste your project URL and anon key below.
# These are VITE_ prefixed so the browser can talk to Supabase directly.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
